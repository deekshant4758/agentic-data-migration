# Copy to .dev.vars for local development overrides.
# NOTE: Non-secret runtime vars (USE_MOCK_AI) live in wrangler.toml under [vars].

# AI model used by the planner (configured in src/worker/ai-agent.ts):
#   @cf/meta/llama-3-8b-instruct  (Cloudflare Workers AI)
# Free tier daily rate limits apply; set the flag below to skip live calls.

# Set to "true" to bypass Workers AI and always return the deterministic
# fallback migration plan (useful for UI development / rate-limit testing).
USE_MOCK_AI=false
